{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openpasture",
  "version": "0.2.0",
  "identifier": "dev.openpasture.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "public.app-category.productivity",
    "shortDescription": "Virtual fencing and grazing decisions for your herd.",
    "copyright": "openpasture",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxODQyQjE0ODk2REQ4NEIKUldSTDJHMkpGQ3VFVWJXL2VZeGNhcmxsWGlRcVIrMmtIdXYwRlhDbUVZWFBDT3ZVY3RhZUNjUmMK",
      "endpoints": [
        "https://github.com/open-pasture/openpasture/releases/latest/download/latest.json"
      ]
    }
  }
}
